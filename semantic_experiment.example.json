{
  "schema_version": "1.0",
  "activation_targets": {
    "positive_fractions": [0.1, 0.25, 0.5],
    "min_positive_samples": 20
  },
  "objective": {
    "objective": "f2",
    "min_precision": 0.5,
    "min_lift": 1.5,
    "max_rules": 5,
    "max_rule_length": 3,
    "min_marginal_recall": 0.02,
    "exhaustive_candidate_limit": 20,
    "beam_width": 64
  },
  "discovery": {
    "backend": "randomized_tree",
    "n_bootstraps": 30,
    "trees_per_bootstrap": 100,
    "max_depth": 3,
    "min_samples_leaf": 0.01,
    "max_features": "sqrt",
    "splitter": "random",
    "positive_leaf_probability": 0.5,
    "min_positive_leaf_samples": 2,
    "max_candidates_per_bootstrap": 20,
    "min_family_recurrence": 0.5,
    "family_similarity_threshold": 0.7
  },
  "runtime": {
    "seed": 42,
    "n_jobs": 1,
    "cache": true,
    "artifact_dir": "stats/semantic"
  },
  "clinical_groups_path": "clinical_groups.example.json"
}
